# Copia este archivo como .env y completa los valores. NUNCA subas .env a Git.

# development | production
APP_ENV=development

# Clave secreta larga y aleatoria. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Opcional. Por defecto se usa SQLite en instance/quecocino.db
# DATABASE_URL=sqlite:////home/tuusuario/cocinaec/instance/quecocino.db

# En producción con HTTPS (PythonAnywhere lo tiene), deja esto en true
SESSION_COOKIE_SECURE=false

# Administrador que crea seed.py. En producción ADMIN_PASSWORD es obligatorio.
ADMIN_EMAIL=admin@quecocino.local
ADMIN_PASSWORD=

APP_TIMEZONE=America/Guayaquil

# Despliegue automático con webhook de GitHub (ver README).
# Genera el secreto con: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=
DEPLOY_BRANCH=main
DEPLOY_WSGI_FILE=/var/www/cocinaec_pythonanywhere_com_wsgi.py
